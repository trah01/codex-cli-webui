HOST=127.0.0.1
PORT=8899
# Optional explicit machine token for Bearer clients (disabled when OTP/OIDC is enabled).
# CODEX_WEBUI_ACCESS_TOKEN=replace-with-a-long-random-secret

# Optional browser login password. Once configured, local access also requires login.
# When unset, open http://127.0.0.1:8899/settings/access-settings on the server to set an account and password.
# Credential creation and changes reject LAN, domain, localhost, IPv6 and forwarded requests.
# CODEX_WEBUI_PASSWORD=replace-with-a-long-random-password
# Bind a domain on the same local settings page before accessing remotely.
# Domain settings are saved next to the credential file with an .access.json suffix.
# Optional path for the salted managed password credential.
# CODEX_WEBUI_AUTH_STORE=/path/to/.codex/codex-webui-auth.json
# Defaults to the repository directory.
CODEX_WEBUI_CWD=/path/to/your/project
# Undo/Reapply is restricted to this exact Git repository root by default.
CODEX_WEBUI_REVIEW_ROOT=/path/to/your/project
# Optional custom Codex state/auth locations.
# CODEX_HOME=/path/to/.codex
# Prefer the existing local Codex daemon; use standalone for an isolated backend.
CODEX_WEBUI_APP_SERVER_MODE=auto
# CODEX_WEBUI_APP_SERVER_SOCKET=/path/to/.codex/app-server-control/app-server-control.sock
# CODEX_AUTH_PATH=/path/to/.codex/auth.json
# Optional browser binary for Playwright scripts.
PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chrome-or-edge

# Optional ntfy push notifications on task completion.
# Set a topic to enable (subscribe to the same topic in the ntfy app or at https://ntfy.sh).
# CODEX_WEBUI_NTFY_TOPIC=my-codex-topic
# Optional custom ntfy server URL (defaults to https://ntfy.sh).
# CODEX_WEBUI_NTFY_URL=https://ntfy.sh

# Docker Compose settings (optional; host paths are intentionally generic).
# PUID=1000
# PGID=1000
# WEBUI_BIND_IP=127.0.0.1
# CODEX_HOME_HOST=/home/USERNAME/.codex
# CODEX_BIN=/home/USERNAME/.codex/packages/standalone/releases/VERSION/bin/codex
# CONTAINER_HOME=/home/codex
# CONTAINER_CODEX_HOME=/home/codex/.codex

# Authentication: password (default), oidc (default when OIDC issuer is set), or both.
# CODEX_WEBUI_AUTH_MODE=password
# External HTTPS origin, required behind a TLS reverse proxy for Secure session cookies.
# CODEX_WEBUI_PUBLIC_ORIGIN=https://codex.example.com
# Optional TOTP second factor for password login: random Base32 secret of at least 32 characters.
# Generate locally: node --input-type=module -e "import {Secret} from 'otpauth'; console.log(new Secret({size:20}).base32)"
# Enroll the SAME secret in your authenticator: SHA1, 6 digits, 30 seconds. Restart to apply.
# CODEX_WEBUI_OTP_SECRET=REPLACE_WITH_RANDOM_BASE32_SECRET
# OIDC requires HTTPS, an explicit subject allowlist, and the domain binding configured locally first.
# CODEX_WEBUI_OIDC_ISSUER=https://identity.example.com/realms/example
# CODEX_WEBUI_OIDC_CLIENT_ID=codex-webui
# CODEX_WEBUI_OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# CODEX_WEBUI_OIDC_REDIRECT_URI=https://codex.example.com/api/auth/oidc/callback
# Exact OIDC sub values, comma-separated. No automatic user registration.
# CODEX_WEBUI_OIDC_ALLOWED_SUBJECTS=REPLACE_WITH_ADMIN_SUBJECT
